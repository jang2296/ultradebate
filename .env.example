# CLI collaboration uses the login of the running Claude/Codex processes.
# API keys are optional for separately invoked CLI worker modes.
# Never place subscription session tokens in API-key variables.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional knobs
ULTRADEBATE_BASE=~/.ultradebate
ULTRADEBATE_MAX_ROUNDS=5
ULTRADEBATE_TOKEN_BUDGET=300000
ULTRADEBATE_MODE=lenient           # strict | lenient
ULTRADEBATE_CONVERGENCE_DELTA=0.05

# Per-agent CLI customization (only set if your CLI flags differ)
# ULTRADEBATE_CLAUDE_BIN=claude
# ULTRADEBATE_CLAUDE_ARGS=-p
# ULTRADEBATE_CODEX_BIN=codex
# ULTRADEBATE_CODEX_ARGS=exec --full-auto
# ULTRADEBATE_GEMINI_BIN=gemini
# ULTRADEBATE_GEMINI_ARGS=-p

# Set to 1 to bypass real CLIs (mock workers) — useful for dev without API costs
# ULTRADEBATE_MOCK=1
